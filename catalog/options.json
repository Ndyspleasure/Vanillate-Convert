{
  "$schema": "./schema/options.schema.json",
  "options": [
    {
      "id": "quality",
      "type": "integer",
      "label": {
        "en": "Quality",
        "id": "Kualitas"
      },
      "help": {
        "en": "Higher quality means a larger file.",
        "id": "Kualitas lebih tinggi berarti ukuran file lebih besar."
      },
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 85,
      "unit": "%"
    },
    {
      "id": "lossless",
      "type": "boolean",
      "label": {
        "en": "Lossless compression",
        "id": "Kompresi lossless"
      },
      "help": {
        "en": "Keeps every pixel exactly. Files are larger.",
        "id": "Menjaga setiap piksel tetap sama persis. Ukuran file lebih besar."
      },
      "advanced": true,
      "default": false
    },
    {
      "id": "background",
      "type": "color",
      "label": {
        "en": "Background color",
        "id": "Warna latar"
      },
      "help": {
        "en": "Used to fill transparent areas when the output has no transparency.",
        "id": "Dipakai untuk mengisi area transparan jika format hasil tidak mendukung transparansi."
      },
      "advanced": true,
      "default": "#ffffff"
    },
    {
      "id": "width",
      "type": "integer",
      "label": {
        "en": "Width",
        "id": "Lebar"
      },
      "help": {
        "en": "Leave empty to keep the original size. The aspect ratio is kept.",
        "id": "Kosongkan untuk mempertahankan ukuran asli. Rasio aspek tetap dijaga."
      },
      "advanced": true,
      "min": 1,
      "max": 16384,
      "unit": "px"
    },
    {
      "id": "height",
      "type": "integer",
      "label": {
        "en": "Height",
        "id": "Tinggi"
      },
      "help": {
        "en": "Leave empty to keep the original size. The aspect ratio is kept.",
        "id": "Kosongkan untuk mempertahankan ukuran asli. Rasio aspek tetap dijaga."
      },
      "advanced": true,
      "min": 1,
      "max": 16384,
      "unit": "px"
    },
    {
      "id": "dpi",
      "type": "integer",
      "label": {
        "en": "Resolution",
        "id": "Resolusi"
      },
      "help": {
        "en": "Dots per inch used when rendering pages. 150 is good for screens, 300 for printing.",
        "id": "Titik per inci saat merender halaman. 150 cocok untuk layar, 300 untuk cetak."
      },
      "min": 36,
      "max": 600,
      "step": 1,
      "default": 150,
      "unit": "dpi"
    },
    {
      "id": "pageRange",
      "type": "text",
      "label": {
        "en": "Pages",
        "id": "Halaman"
      },
      "help": {
        "en": "For example 1-3,5. Leave empty for all pages.",
        "id": "Contoh: 1-3,5. Kosongkan untuk semua halaman."
      },
      "advanced": true,
      "pattern": "^\\s*\\d{1,5}(\\s*-\\s*\\d{1,5})?(\\s*,\\s*\\d{1,5}(\\s*-\\s*\\d{1,5})?){0,49}\\s*$",
      "maxLength": 100
    },
