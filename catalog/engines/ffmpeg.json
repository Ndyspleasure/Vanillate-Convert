{
  "$schema": "../schema/engine.schema.json",
  "engine": {
    "id": "ffmpeg",
    "name": "FFmpeg",
    "mode": "server",
    "status": "available",
    "description": "Audio and video transcoding. Demuxers are forced from the detected format and only the file protocol is allowed.",
    "homepage": "https://ffmpeg.org",
    "license": "LGPL-2.1+ (GPL-2.0+ when built with libx264/libx265)",
    "licenseNotes": "Builds with x264/x265 are GPL. Running as a separate process in a hosted service is fine; distributing container images requires GPL source availability. H.265/HEVC and AAC may carry patent licensing obligations depending on jurisdiction.",
    "binaries": ["ffmpeg"],
    "pool": "media",
    "capabilities": {
      "read": [
        "mp3",
        "wav",
        "flac",
        "aac",
        "m4a",
        "m4r",
        "ogg",
        "opus",
        "aiff",
        "wma",
        "amr",
        "ac3",
        "dts",
        "ape",
        "mka",
        "mp4",
        "m4v",
        "mov",
        "mkv",
        "webm",
        "avi",
        "wmv",
        "asf",
        "flv",
        "mpg",
        "vob",
        "ts",
        "m2ts",
        "3gp",
        "3g2",
        "ogv",
        "rm",
        "gif",
        "apng"
      ],
      "write": [
        "mp3",
        "wav",
        "flac",
        "aac",
        "m4a",
        "alac",
        "m4r",
        "ogg",
        "opus",
        "aiff",
        "wma",
        "ac3",
        "mka",
        "mp4",
        "m4v",
        "mov",
        "mkv",
        "webm",
        "avi",
        "wmv",
        "flv",
        "mpg",
        "ts",
        "3gp",
        "ogv",
        "gif",
        "srt",
        "vtt",
        "ass"
      ]
    }
  }
}
