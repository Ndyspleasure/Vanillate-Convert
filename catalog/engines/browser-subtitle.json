    "capabilities": {
      "read": ["srt", "vtt", "sbv", "ass", "ssa", "sub", "ttml", "dfxp"],
      "write": ["srt", "vtt", "sbv", "ass", "sub", "ttml", "dfxp", "txt"]
    }
  }
}
