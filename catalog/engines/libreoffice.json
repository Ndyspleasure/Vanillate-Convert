{
  "$schema": "../schema/engine.schema.json",
  "engine": {
    "id": "libreoffice",
    "name": "LibreOffice",
    "mode": "server",
    "status": "available",
    "description": "Headless office document conversion (Writer, Calc, Impress, Draw) with an isolated user profile per job.",
    "homepage": "https://www.libreoffice.org",
    "license": "MPL-2.0",
    "licenseNotes": "Weak copyleft; running unmodified binaries is unrestricted.",
    "binaries": ["soffice", "libreoffice"],
    "pool": "document",
    "capabilities": {
      "read": [
        "pdf",
        "doc",
        "docx",
        "odt",
        "rtf",
        "txt",
        "html",
        "wpd",
        "pages",
        "xls",
        "xlsx",
        "xlsm",
        "xlsb",
        "ods",
        "csv",
        "dbf",
        "numbers",
        "ppt",
        "pptx",
        "ppsx",
        "odp",
        "key",
        "emf",
        "wmf",
        "cdr",
        "dxf"
      ],
      "write": [
        "pdf",
        "docx",
        "doc",
        "odt",
        "rtf",
        "txt",
        "html",
        "epub",
        "xlsx",
        "xls",
        "ods",
        "csv",
        "pptx",
        "ppt",
        "odp",
        "svg",
        "png"
      ]
    }
  }
}
