{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "engine": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "browser",
            "server"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "available",
            "unavailable",
            "degraded",
            "disabled",
            "experimental",
            "deprecated"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "homepage": {
          "type": "string",
          "format": "uri"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "licenseNotes": {
          "type": "string"
        },
        "binaries": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9._-]+$"
          }
        },
        "pool": {
          "type": "string",
          "enum": [
            "image",
            "media",
            "document",
            "archive",
            "data",
            "specialized"
          ]
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "read": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 24,
                "pattern": "^[a-z0-9]+$"
              }
            },
            "write": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 24,
                "pattern": "^[a-z0-9]+$"
              }
            }
          },
          "required": [
            "read",
            "write"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "name",
        "mode",
        "status",
        "description",
        "homepage",
        "license",
        "capabilities"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "engine"
  ],
  "additionalProperties": false
}
