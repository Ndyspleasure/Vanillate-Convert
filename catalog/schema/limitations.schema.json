{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "limitations": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning"
            ]
          },
          "text": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "en",
              "id"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "severity",
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "limitations"
  ],
  "additionalProperties": false
}
