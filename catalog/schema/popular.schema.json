{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "conversions": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string",
            "maxLength": 24,
            "pattern": "^[a-z0-9]+$"
          },
          {
            "type": "string",
            "maxLength": 24,
            "pattern": "^[a-z0-9]+$"
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    },
    "tools": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
      }
    }
  },
  "required": [
    "conversions",
    "tools"
  ],
  "additionalProperties": false
}
