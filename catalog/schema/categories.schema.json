{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "categories": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "image",
              "pdf",
              "document",
              "spreadsheet",
              "presentation",
              "audio",
              "video",
              "archive",
              "data",
              "developer",
              "ebook",
              "subtitle",
              "font",
              "vector",
              "3d",
              "cad",
              "scientific",
              "web",
              "metadata",
              "specialized"
            ]
          },
          "name": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "en",
              "id"
            ],
            "additionalProperties": false
          },
          "description": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "en",
              "id"
            ],
            "additionalProperties": false
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "icon": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "order",
          "icon"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "categories"
  ],
  "additionalProperties": false
}
