# Vanillate Convert — environment variables.
#
# Copy to `.env.local` (web app) or pass to the worker's environment. Every variable is optional
# unless marked REQUIRED; without any of them the site runs browser-only.
# Never commit real secrets.

# ----------------------------------------------------------------------------- web app (Vercel)

# Canonical origin for canonical URLs, hreflang, the sitemap and Open Graph.
# Defaults to https://$VERCEL_PROJECT_PRODUCTION_URL on Vercel, else http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "enabled" when workers, a database and storage exist. Read at BUILD time (static pages and
# the sitemap include server conversions only when enabled) and at runtime (API routes).
# Any other value builds a browser-only site.
VANILLATE_SERVER_PROCESSING=disabled

# Refuse new jobs when no live worker can run them (default true). Set to "false" only for
# tests that create jobs without a worker.
# VANILLATE_REQUIRE_WORKERS=true

# Salt for the anonymous, hashed client key used by rate limiting. Set a random value in
# production so keys cannot be recomputed from IP addresses.
# RATE_LIMIT_SALT=

# Structured log level: debug | info | warn | error (default info).
# LOG_LEVEL=info

# Run a worker inside the web server process (local development and end-to-end tests only).
# Must be set at build time and at runtime; builds without it do not contain the worker.
# VANILLATE_EMBEDDED_WORKER=1

# ----------------------------------------------------------------------------- job store

# PostgreSQL connection string (REQUIRED for server processing, unless JOB_STORE=memory).
# Apply migrations with `pnpm db:migrate`.
# DATABASE_URL=postgres://vanillate:vanillate@localhost:5432/vanillate
# DATABASE_SSL=false
# DATABASE_POOL_MAX=5

# "memory" keeps jobs in process memory: single-process development and tests only.
# JOB_STORE=memory

# ----------------------------------------------------------------------------- storage

# local | s3 | memory. Required for server processing.
# STORAGE_DRIVER=local

# local: a directory shared by the web app and the worker, and the HMAC secret for upload and
# download tokens (at least 32 characters; generate with `openssl rand -base64 48`).
# STORAGE_LOCAL_DIR=/var/lib/vanillate/storage
# STORAGE_SIGNING_SECRET=
# STORAGE_PUBLIC_PATH=/api/v1/storage

# s3: any S3-compatible service (AWS S3, Cloudflare R2, MinIO). Browsers upload and download
# with presigned URLs, so the bucket needs a CORS rule allowing PUT/GET from the site origin.
# Configure a lifecycle rule as a backstop for the platform's own cleanup (see docs/STORAGE.md).
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_PUBLIC_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=vanillate-convert
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# ----------------------------------------------------------------------------- worker

# WORKER_ID=worker-1
# Pools this worker serves: comma-separated (image, media, document, archive, data,
# specialized) or "all".
# WORKER_POOLS=all
# WORKER_CONCURRENCY=2
# WORKER_WORK_DIR=/var/lib/vanillate/work
# WORKER_LEASE_SECONDS=60
# WORKER_POLL_MS=1000
# WORKER_SWEEP_SECONDS=60
# WORKER_SHUTDOWN_GRACE_MS=25000

# Engine isolation (see docs/SECURITY.md). Production refuses to start without a sandbox or an
# unprivileged engine user unless VANILLATE_ALLOW_UNISOLATED=1 (unsafe).
# VANILLATE_SANDBOX=auto            # auto | bwrap | none
# VANILLATE_ENGINE_USER=auto        # auto | none | <uid>:<gid>
# VANILLATE_ALLOW_UNISOLATED=0

# Engines this worker must not use (comma-separated ids, e.g. "pandoc,assimp").
# VANILLATE_DISABLED_ENGINES=

# Python interpreter with fontTools (and brotli for WOFF2) for the font engine.
# VANILLATE_PYTHON=python3

# Reported in the worker registration and health output (e.g. the image tag or commit).
# VANILLATE_VERSION=
